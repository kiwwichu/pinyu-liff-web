# Public project URL. Safe to expose, but keep the real value outside Git for consistency.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only Supabase secret key. Never use this in browser JavaScript.
SUPABASE_SECRET_KEY=replace-with-cloudflare-secret

# LINE secrets. Store these with `wrangler secret put`, never in this file.
LINE_CHANNEL_ACCESS_TOKEN=replace-with-cloudflare-secret
LINE_CHANNEL_SECRET=replace-with-cloudflare-secret
